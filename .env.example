# ── Database (Prisma / Postgres) ─────────────────────────────
# Neon: use the DIRECT (non-pooled) string; keep ?sslmode=require.
#   postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local Docker (docker compose up db):
#   postgresql://postgres:postgres@localhost:5433/jantax?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jantax?schema=public"

# ── API server ──────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# JWT signing key. 32+ chars. Required in production (server refuses to start).
JWT_SECRET="change-me-to-32+char-random-string"

# Allowed browser origins, comma-separated. Empty in dev = allow all.
# Required in production, e.g. "https://jantax.vercel.app"
CORS_ORIGIN=""

# Number of reverse-proxy hops to trust for client IP (rate limiting).
# 0 when hit directly; 1 behind Render/Railway/Nginx.
TRUST_PROXY=0

# Optional read key for future rate-limit tiers (unused).
API_READ_KEY=""

# ── Data (Rule 40) ──────────────────────────────────────────
# Seed fictional sample rows (flagged isSample=true).
# Default: on in dev, off in production. "false" forces off, "true" forces on.
SEED_SAMPLE_DATA=""

# Run the mock UDISE connector 15s after dev start (writes isSample rows).
ENABLE_MOCK_CONNECTORS="false"

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL="http://localhost:4000"
