# Postgres connection string used by Prisma (backend API server).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jantax?schema=public"

# JWT secret for auth (must be 32+ chars, never commit production value)
JWT_SECRET="change-me-to-32+char-random-string"

# Backend port
PORT=4000

# Frontend API base (Vite). Leave empty for localhost:4000 fallback.
VITE_API_URL="http://localhost:4000"

# ---- Real data (see docs/DATA_LAYER.md) ----
# Free key from https://data.gov.in (sign in, then My Account > API key). Needed by the
# CPCB air quality connector and by API-mode refreshes of the India Post PIN directory.
DATA_GOV_IN_API_KEY=""

# Run connectors on their schedules (hourly air quality, monthly PIN directory).
# Defaults to on when NODE_ENV=production, off otherwise.
SYNC_SCHEDULE="off"

# Keep a gzipped copy of every download so any figure can be traced to its source bytes.
RAW_DATA_DIR="./data/raw"

# Only if data.gov.in re-publishes a dataset under a new resource id.
# PINCODE_DIRECTORY_RESOURCE_ID=""
# CPCB_AQI_RESOURCE_ID=""

# Optional: public read-only key for future rate-limit (currently unused, keep empty)
API_READ_KEY=""

# Environment
NODE_ENV="development"
