# Postgres connection string used by Prisma (backend API server).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jantax?schema=public"

# JWT secret for auth (must be 32+ chars, never commit production value)
JWT_SECRET="change-me-to-32+char-random-string"

# Backend port
PORT=4000

# Frontend API base (Vite). Leave empty for localhost:4000 fallback.
VITE_API_URL="http://localhost:4000"

# ---- Real data (see docs/DATA_LAYER.md) ----
# Free key from https://data.gov.in (sign in, then My Account > API key). Needed by the
# CPCB air quality connector and by API-mode refreshes of the India Post PIN directory.
DATA_GOV_IN_API_KEY=""

# Run connectors on their schedules (hourly air quality, monthly PIN directory).
# Defaults to on when NODE_ENV=production, off otherwise.
SYNC_SCHEDULE="off"

# Keep a gzipped copy of every download so any figure can be traced to its source bytes.
RAW_DATA_DIR="./data/raw"

# Only if data.gov.in re-publishes a dataset under a new resource id.
# PINCODE_DIRECTORY_RESOURCE_ID=""
# CPCB_AQI_RESOURCE_ID=""

# ---- Dataset catalog (docs/DATASETS.md, docs/GO_LIVE.md) ----
# Each setting switches one dataset on. Leave empty until you have checked it:
#   npm run data -- inspect <dataset id>
# data.gov.in resource ids (the UUID on the dataset's API tab); these also need DATA_GOV_IN_API_KEY.
OGD_CENSUS_DISTRICTS=""          # census-2011-districts: district population, households, literacy
OGD_UDISE_DISTRICT_SCHOOLS=""    # udise-district-schools: schools, facilities, teachers by district
OGD_NHP_HOSPITALS=""             # nhp-hospital-directory: hospitals with PIN and coordinates
OGD_RHS_DISTRICT=""              # rhs-district-facilities: sub-centres, PHCs, CHCs by district
OGD_NFSA_DISTRICT=""             # nfsa-district-fps: fair price shops and ration cards by district
OGD_NFSA_OFFTAKE=""              # nfsa-state-offtake: foodgrain allocation and offtake by state
OGD_JJM_DISTRICT=""              # jjm-district-coverage: household tap connections by district
OGD_POWER_HOURS=""               # power-supply-hours: hours of supply by state
OGD_PMGSY_DISTRICT=""            # pmgsy-district-progress: rural road works by district
OGD_MPLADS_STATE=""              # mplads-state-funds: MPLADS money released and spent by state
OGD_COURT_PENDENCY=""            # court-pendency-states: cases pending in district courts by state
OGD_RTI_RETURNS=""               # rti-returns: RTI requests by public authority
OGD_CPGRAMS_MINISTRY=""          # cpgrams-ministry-disposal: grievances by ministry
OGD_SWACHH_SURVEKSHAN=""         # swachh-survekshan-cities: city cleanliness scores
OGD_GE2024_RESULTS=""            # ge2024-results: Lok Sabha 2024 constituency results
OGD_DILRMP_PROGRESS=""           # dilrmp-progress: land records computerisation by state
# Open Budgets India (CKAN) resource id.
OBI_STATE_BUDGET_RESOURCE=""     # state-budget-sectors
# Direct download links (or import the file with --file instead).
LGD_DISTRICTS_URL=""             # lgd-districts: LGD district list as CSV
MPLADS_WORKS_URL=""              # mplads-works: MPLADS works report as XLSX
# No setting (file import only): cppp-awards, rera-projects, ward-services, cag-audit-findings,
# candidate-affidavits, polling-stations. Templates are in data/templates/.

# Optional: public read-only key for future rate-limit (currently unused, keep empty)
API_READ_KEY=""

# Environment
NODE_ENV="development"
